 "update_config": [
  {
   "after": "<?php\ndefine('DB_NAME', 'new_db');\ndefine('DB_USER', 'new_user');\ndefine('DB_PASSWORD', 'new_pass');\ndefine('DB_HOST', 'localhost');\n",
   "before": "<?php\ndefine('DB_NAME', 'old');\ndefine('DB_USER', 'olduser');\ndefine('DB_PASSWORD', 'oldpass');\ndefine('DB_HOST', 'oldhost');\n",
   "case": "wp_full",
   "file": "wp-config.php"
  },
  {
   "after": "<?php\ndefine('DB_NAME', 'new_db');\n\ndefine('DB_USER', 'new_user');\n\ndefine('DB_PASSWORD', 'new_pass');\n\ndefine('DB_HOST', 'localhost');\n",
   "before": "<?php\ndefine('DB_NAME', 'old');\n",
   "case": "wp_partial",
   "file": "wp-config.php"
  },
  {
   "after": "<?php\ndefine(\"DB_NAME\", 'new_db');\n\ndefine('DB_USER', 'new_user');\n\ndefine('DB_PASSWORD', 'new_pass');\n\ndefine('DB_HOST', 'localhost');\n",
   "before": "<?php\ndefine(\"DB_NAME\", \"old\");\n",
   "case": "wp_double_quoted",
   "file": "wp-config.php"
  },
  {
   "after": "<?php\n\ndefine('DB_NAME', 'new_db');\n\ndefine('DB_USER', 'new_user');\n\ndefine('DB_PASSWORD', 'new_pass');\n\ndefine('DB_HOST', 'localhost');\n",
   "before": "<?php\n",
   "case": "wp_empty",
   "file": "wp-config.php"
  },
  {
   "after": "APP_NAME=x\nDB_DATABASE=new_db\nDB_USERNAME=new_user\nDB_PASSWORD=new_pass\nDB_HOST=127.0.0.1\n",
   "before": "APP_NAME=x\nDB_DATABASE=old\nDB_USERNAME=olduser\nDB_PASSWORD=oldpass\nDB_HOST=oldhost\n",
   "case": "env_full",
   "file": ".env"
  },
  {
   "after": "DB_DATABASE=new_db\nDB_USERNAME=new_user\nDB_PASSWORD=new_pass\nDB_HOST=127.0.0.1\n",
   "before": "DB_DATABASE=old\n",
   "case": "env_partial",
   "file": ".env"
  },
  {
   "after": "DB_DATABASE=new_db\nDB_USERNAME=new_user\nDB_PASSWORD=new_pass\nDB_HOST=127.0.0.1\n",
   "before": "DB_DATABASE = old\n",
   "case": "env_spaced",
   "file": ".env"
  },
  {
   "after": "DB_DATABASE=new_db\nDB_USERNAME=new_user\nDB_PASSWORD=new_pass\nDB_HOST=127.0.0.1\n",
   "before": "db_database=old\n",
   "case": "env_lowercase",
   "file": ".env"
  },
  {
   "after": "DB_DATABASE=new_db\nDB_USERNAME=new_user\nDB_PASSWORD=new_pass\nDB_HOST=127.0.0.1\n",
   "before": "",
   "case": "env_empty",
   "file": ".env"
  },
  {
   "after": "APP_KEY=abc\nDB_DATABASE=new_db\nDB_USERNAME=new_user\nDB_PASSWORD=new_pass\nDB_HOST=127.0.0.1\n",
   "before": "APP_KEY=abc\n",
   "case": "env_unrelated",
   "file": ".env"
  },
  {
   "after": "DB_DATABASE=new_db\nDB_USERNAME=new_user\nDB_PASSWORD=new_pass\nDB_HOST=127.0.0.1\n",
   "before": "DB_DATABASE=old",
   "case": "env_no_trailing_newline",
   "file": ".env"
  },
  {
   "after": "<?php\nclass X {\n public $db = 'new_db';\n public $user = 'new_user';\n public $password = 'new_pass';\n public $host = 'localhost';\n}\n",
   "before": "<?php\nclass X {\n public $db = 'old';\n public $user = 'olduser';\n public $password = 'oldpass';\n public $host = 'oldhost';\n}\n",
   "case": "php_public",
   "file": "configuration.php"
  },
  {
   "after": "<?php\n$db = 'old';\n",
   "before": "<?php\n$db = 'old';\n",
   "case": "php_bare",
   "file": "configuration.php"
  },
  {
   "after": "<?php\npublic db = 'new_db';\n",
   "before": "<?php\npublic db = 'old';\n",
   "case": "php_public_no_dollar",
   "file": "configuration.php"
  },
  {
   "after": "<?php\n",
   "before": "<?php\n",
   "case": "php_empty",
   "file": "configuration.php"
  }
