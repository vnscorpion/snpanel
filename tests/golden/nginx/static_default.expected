server {
    listen 80;
    server_name static-default.example.com www.static-default.example.com;
    root /home/bp_static_default_exa_e797fb6e/static-default.example.com/public_html;
    index index.html index.htm;

    server_tokens off;
    disable_symlinks if_not_owner from=/home/bp_static_default_exa_e797fb6e/static-default.example.com;




    # SNPANEL WAF BEGIN
    modsecurity on;
    modsecurity_rules_file /etc/nginx/modsec/sites/static-default.example.com.conf;
    # SNPANEL WAF END


    access_log /var/log/nginx/static-default.example.com.access.log;
    error_log /var/log/nginx/static-default.example.com.error.log;

    client_max_body_size 1100M;

    # SNPANEL ACME CHALLENGE
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/snpanel-acme;
        default_type text/plain;
        try_files $uri =404;
        access_log off;
        auth_basic off;
    }

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), magnetometer=(), gyroscope=(), accelerometer=()" always;

    autoindex off;

    location ~* \.(?:sql|bak|backup|old|orig|save|swp|swo|ini|log|conf|env|sh|inc)$ {
        deny all;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }

    location ~ /\.ht {
        deny all;
    }

    # Static-only site: refuse to execute any PHP / CGI even if a script
    # somehow lands in the document root.
    location ~* \.(?:php|phtml|phar|php3|php4|php5|php7|php8|cgi|pl|py)$ {
        deny all;
        return 403;
    }

    # SNPANEL CUSTOM INCLUDE
    include /etc/nginx/snpanel/custom/static-default.example.com.conf;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~* \.(jpg|jpeg|gif|png|css|js|ico|webp|svg|woff|woff2|ttf|eot)$ {
        expires -1;
        access_log off;
    }
}
