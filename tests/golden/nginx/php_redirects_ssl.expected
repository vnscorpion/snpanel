server {
    listen 80;
    server_name php-redirects-ssl.example.com www.php-redirects-ssl.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl http2;
    server_name php-redirects-ssl.example.com www.php-redirects-ssl.example.com;
    ssl_certificate /etc/nginx/snpanel/ssl/sites/php-redirects-ssl.example.com/cert.crt;
    ssl_certificate_key /etc/nginx/snpanel/ssl/sites/php-redirects-ssl.example.com/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    root /home/bp_php_redirects_ssl__15efba3a/php-redirects-ssl.example.com/public_html;
    index index.php index.html index.htm;

    server_tokens off;
    disable_symlinks if_not_owner from=/home/bp_php_redirects_ssl__15efba3a/php-redirects-ssl.example.com;




    # SNPANEL WAF BEGIN
    modsecurity on;
    modsecurity_rules_file /etc/nginx/modsec/sites/php-redirects-ssl.example.com.conf;
    # SNPANEL WAF END


    access_log /var/log/nginx/php-redirects-ssl.example.com.access.log;
    error_log /var/log/nginx/php-redirects-ssl.example.com.error.log;

    client_max_body_size 1100M;

    # SNPANEL ACME CHALLENGE
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/snpanel-acme;
        default_type text/plain;
        try_files $uri =404;
        access_log off;
        auth_basic off;
    }

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), magnetometer=(), gyroscope=(), accelerometer=()" always;

    autoindex off;

    location ~* \.(?:sql|bak|backup|old|orig|save|swp|swo|ini|log|conf|env|sh|inc)$ {
        deny all;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_read_timeout 300;
    }

    location ~ /\.ht {
        deny all;
    }

    # SNPANEL CUSTOM INCLUDE
    include /etc/nginx/snpanel/custom/php-redirects-ssl.example.com.conf;


    location / {
        try_files $uri $uri/ =404;
    }


    location ~* \.(jpg|jpeg|gif|png|css|js|ico|webp|svg|woff|woff2|ttf|eot)$ {
        expires -1;
        access_log off;
    }
}

server {
    listen 80;
    server_name legacy.example.com;

    # SNPANEL ACME CHALLENGE
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/snpanel-acme;
        default_type text/plain;
        try_files $uri =404;
        access_log off;
        auth_basic off;
    }

    return 301 https://php-redirects-ssl.example.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name legacy.example.com;
    ssl_certificate /etc/nginx/snpanel/ssl/sites/php-redirects-ssl.example.com/cert.crt;
    ssl_certificate_key /etc/nginx/snpanel/ssl/sites/php-redirects-ssl.example.com/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    return 301 https://php-redirects-ssl.example.com$request_uri;
}
