user nginx;
worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # SNPanel: distribution default server disabled. The panel serves
    # the default vhost from conf.d/00-snpanel-tools.conf, and two
    # default_server blocks make nginx refuse to start.
#    server {
#        listen 80;
#        listen [::]:80;
#        server_name _;
#        root /usr/share/nginx/html;
#
#        include /etc/nginx/default.d/*.conf;
#
#        error_page 404 /404.html;
#        location = /404.html {
#        }
#    }

    include /etc/nginx/conf.d/*.conf;
}
