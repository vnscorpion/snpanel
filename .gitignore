# SNPanel runtime
backend/snpanel.db

# Landing page. Anchored with a leading slash: an unanchored `style.css`
# matches at every depth, and it quietly kept frontend/src/style.css - the
# panel's own stylesheet, imported by App.jsx - out of the repository, so a
# clean clone could not build the frontend at all.
/landing.html
/style.css

# Dev / CI / tooling (not part of release)
.codex/
# NOT .github/ - the workflows and the dependabot config have to be committed
# for GitHub to run them at all. The two files there today predate the rule and
# survive only because tracked files ignore .gitignore; a *new* workflow would
# have been skipped by `git add` without saying why.
.ruff_cache/
.vendor/
skills/
prompts/

# Scripts not part of setup
check.py
patch*.py
do_patch.py
fix_include.py
remote_fix.py
test_ssh.py
setup.sh
change_IP.sh

# NOT backend/tests/ - those 23 tests are part of the suite, the same as
# backend/app/tests/. Excluding them only meant a clone could not run them.

# Misc
images.zip

# Rust
/target/

# Claude Code's code index - a generated cache, not source
.codebase-memory/
